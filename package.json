{
  "name": "anywherecoding",
  "version": "0.2.0",
  "private": true,
  "description": "Mobile-friendly web control for local Codex, Claude Code, PI-Desktop and Pi CLI sessions",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "repository": { "type": "git", "url": "https://github.com/chilin11/anywherecoding.git" },
  "homepage": "https://github.com/chilin11/anywherecoding#readme",
  "bugs": { "url": "https://github.com/chilin11/anywherecoding/issues" },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'server/**/*.test.ts'",
    "dmg": "pnpm build && node scripts/macapp.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
